{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shomosite",
  "compatibility_date": "2026-04-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "routes": [
    {
      "pattern": "shomodip.com",
      "custom_domain": true
    },
    {
      "pattern": "www.shomodip.com",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
